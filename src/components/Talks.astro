---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import talksData from '../data/talks.json';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/*.{jpeg,jpg,png,gif,avif,webp}');

const { featured, past } = talksData;
---

<section class="bg-scipyNavy py-0" id="upcoming">
  <div class="section-header-navy text-center">Próximas Charlas</div>
  <div class="max-w-7xl mx-auto p-8">
    <div class="bg-white rounded shadow-2xl overflow-hidden flex flex-col md:flex-row">
      <div class="p-8 flex-1">
        <span class="inline-block px-3 py-1 bg-pyOrange text-white text-xs font-bold uppercase mb-4">Evento Destacado</span>
        <p class="text-scipyLightBlue font-bold text-lg mb-2">{featured.date} • {featured.time}</p>
        <h3 class="text-3xl font-display text-scipyNavy uppercase mb-4 leading-tight">{featured.title}</h3>
        <p class="text-gray-600 leading-relaxed mb-6">
          {featured.description}
        </p>

        <div class="flex items-center space-x-4 p-4 border-l-4 border-scipyForest bg-gray-50">
          <div class="h-12 w-12 rounded-full bg-scipyNavy text-white flex items-center justify-center font-bold">{featured.speaker.initials}</div>
          <div>
            <p class="font-bold text-scipyNavy">{featured.speaker.name}</p>
            <p class="text-sm text-gray-500 italic">{featured.speaker.role}</p>
          </div>
        </div>
      </div>
      <div class="md:w-1/3 bg-gray-100 p-8 flex flex-col justify-center items-center text-center">
        <p class="font-display text-scipyNavy text-xl mb-4">EL REGISTRO ESTÁ ABIERTO</p>
        <button class="w-full bg-scipyForest text-white font-display text-xl py-4 rounded hover:bg-green-800 transition shadow-md">REGÍSTRATE AHORA</button>
        <p class="mt-4 text-xs text-gray-500">Entrada gratuita para todos los miembros de la comunidad.</p>
      </div>
    </div>
  </div>
</section>

<!-- Past Talks -->
<section class="bg-scipyForest py-0" id="past">
  <div class="section-header-green text-center">Galería de Charlas Pasadas</div>
  <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {past.map(async (talk) => {
        const imgResolver = talk.image ? images[talk.image] : null;
        const imgModule = imgResolver ? await imgResolver() : null;

        return (
        <div class="bg-white rounded overflow-hidden shadow-xl transform transition hover:-translate-y-1 flex flex-col">
          <div class="h-48 bg-gray-200 flex items-center justify-center border-b border-gray-100 overflow-hidden">
            {imgModule ? (
              <Image src={imgModule.default} alt={talk.title} class="w-full h-full object-cover object-center" />
            ) : talk.image ? (
              <img src={talk.image} alt={talk.title} class="w-full h-full object-cover object-center" />
            ) : (
              <span class="text-gray-400 font-display uppercase italic text-sm">Documentación del Evento</span>
            )}
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class="text-xs text-scipyForest font-bold uppercase tracking-widest mb-1">{talk.date}</p>
            <h4 class="text-xl font-display text-scipyNavy uppercase">{talk.title}</h4>
            <p class="text-gray-500 mt-2 text-sm italic">Ponente: {talk.speaker}</p>
            <div class="mt-auto pt-4">
              <a class="inline-block text-xs font-bold text-scipyNavy hover:underline uppercase" href={talk.materialsUrl}>Ver Materiales →</a>
            </div>
          </div>
        </div>
      )})}
    </div>
  </div>
</section>
