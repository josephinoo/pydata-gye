---
import { Image } from 'astro:assets';
import numfocusLogo from '../assets/logos/numfocus.png';
---

<footer class="footer-green text-white py-16">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 border-b border-white/20 pb-12"
  >
    <div>
      <h4 class="font-display text-2xl uppercase mb-4">Sobre NumFOCUS</h4>
      <p class="text-sm opacity-80 leading-relaxed mb-6">
        NumFOCUS es una organización sin fines de lucro 501(c)(3) que apoya y
        promueve la computación científica de código abierto, innovadora y de
        clase mundial. Para más información, por favor visita nuestro sitio web: <a
          class="underline"
          href="https://www.numfocus.org">https://www.numfocus.org/</a
        >
      </p>
      <Image
        alt="NumFOCUS Logo"
        class="h-12 w-auto brightness-0 invert opacity-90"
        src={numfocusLogo}
      />
    </div>

    <div class="flex flex-col justify-between">
      <div>
        <h4 class="font-display text-xl uppercase mb-2">
          ¿Preguntas? ¿Comentarios?
        </h4>
        <p class="text-sm opacity-80">
          Contacta al equipo organizador a través de Telegram o nuestras redes
          sociales.
        </p>
      </div>
      <div class="mt-8 flex space-x-4">
        <span
          class="p-2 bg-white/10 rounded-full hover:bg-white/20 transition cursor-pointer"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-2 16h-2v-6h2v6zm-1-6.891c-.607 0-1.1-.496-1.1-1.109 0-.612.492-1.109 1.1-1.109s1.1.497 1.1 1.109c0 .613-.493 1.109-1.1 1.109zm8 6.891h-2v-3.86c0-1.171-.205-1.631-1-1.631-.837 0-1 1.001-1 1.631v3.86h-2v-6h2v1.474c.333-.456 1.246-.912 2-.912 1.637 0 2 1.332 2 3.037v2.401z"
            ></path>
          </svg>
        </span>
        <span
          class="p-2 bg-white/10 rounded-full hover:bg-white/20 transition cursor-pointer"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 flex flex-col md:flex-row justify-between items-center opacity-60 text-xs uppercase tracking-widest font-bold"
  >
    <p>© 2024 PyData Guayaquil. Todos los derechos reservados.</p>
    <p>Una comunidad global para herramientas de datos de código abierto.</p>
  </div>
</footer>
