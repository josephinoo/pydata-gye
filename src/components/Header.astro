<header class="scipy-header-bg text-white shadow-lg py-6 min-h-[calc(100vh-2rem)] flex items-center justify-center">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex flex-col items-center">
      <!-- Logo -->
      <div class="mb-6">
        <a href="#">
          <img
            alt="PyData Guayaquil Logo"
            class="h-16 w-auto brightness-0 invert"
            src="data:image/png;base64,"
          />
        </a>
      </div>
      <!-- Title Branding like SciPy -->
      <h1 class="font-display text-5xl md:text-7xl mb-2 text-center">PYDATA GUAYAQUIL</h1>
      <p class="font-display text-xl md:text-2xl opacity-90 text-center uppercase tracking-widest">Guayaquil, Ecuador</p>
      
      <!-- Navigation -->
      <nav class="mt-8 flex flex-wrap justify-center gap-6 text-sm font-bold uppercase tracking-wider">
        <a class="hover:underline" href="#upcoming">Próximas Charlas</a>
        <a class="hover:underline" href="#past">Eventos Pasados</a>
        <a class="hover:underline" href="#team">Organizadores</a>
        <a class="hover:underline" href="#join">Comunidad</a>
        <a class="bg-white text-scipyNavy px-4 py-1 rounded hover:bg-gray-200 transition" href="#join">Únete a Nosotros</a>
